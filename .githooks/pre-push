#!/bin/sh

# Keep the local workspace branch private. Public changes must be pushed from main
# or another explicitly public branch after review.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)

case "$branch" in
  local-work|local/*)
    echo "拒绝推送：$branch 是本地私有分支。请切换到公开分支后再推送。" >&2
    exit 1
    ;;
esac

exit 0
