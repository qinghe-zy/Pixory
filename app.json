{
  "expo": {
    "name": "pixory",
    "slug": "pixory",
    "version": "2.6.10",
    "orientation": "portrait",
    "icon": "./icons/04_右下_聊天图标.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pixory.app",
      "versionCode": 272,
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/pixory-favicon.png"
    },
    "runtimeVersion": "2.6.10",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/f9528887-4f8b-451d-a851-aa1a45e9abae",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF7",
          "image": "./icons/04_右下_聊天图标.png",
          "imageWidth": 192,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pixory 需要访问相册以便导入图片和选择本地头像。",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Pixory 需要访问相册以便保存原图。",
          "savePhotosPermission": "Pixory 需要写入相册以便保存原图。",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-video",
      "./plugins/withPixoryAndroidIntents"
    ],
    "extra": {
      "updateCheck": {
        "enabled": true,
        "url": "https://mist01.com/update-version.json",
        "githubLatestUrl": "https://api.github.com/repos/qinghe-zy/Pixory/releases/latest",
        "fallbackDownloadUrl": "https://mist01.com/#download",
        "timeoutMs": 5000
      },
      "announcement": {
        "enabled": true,
        "url": "https://mist01.com/announcement.json",
        "timeoutMs": 5000
      },
      "eas": {
        "projectId": "f9528887-4f8b-451d-a851-aa1a45e9abae"
      }
    },
    "owner": "qinghe.zy"
  }
}
