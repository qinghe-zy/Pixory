{
  "expo": {
    "name": "pixory",
    "slug": "pixory",
    "version": "2.1.19",
    "orientation": "portrait",
    "icon": "./assets/pixory-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pixory.app",
      "versionCode": 233,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/pixory-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/pixory-favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pixory 需要访问相册以便导入图片和选择本地头像。",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Pixory 需要访问相册以便保存原图。",
          "savePhotosPermission": "Pixory 需要写入相册以便保存原图。",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-video",
      "./plugins/withPixoryAndroidIntents"
    ],
    "extra": {
      "updateCheck": {
        "enabled": true,
        "url": "https://raw.githubusercontent.com/qinghe-zy/Pixory/main/docs/update-version.json",
        "timeoutMs": 5000
      },
      "announcement": {
        "enabled": true,
        "url": "https://raw.githubusercontent.com/qinghe-zy/Pixory/main/docs/announcement.json",
        "timeoutMs": 5000
      },
      "eas": {
        "projectId": "f9528887-4f8b-451d-a851-aa1a45e9abae"
      }
    },
    "owner": "qinghe.zy"
  }
}
