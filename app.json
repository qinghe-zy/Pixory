{
  "expo": {
    "name": "pixory",
    "slug": "pixory",
    "version": "2.6.8",
    "orientation": "portrait",
    "icon": "./docs/assets/og-cover.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF7"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.pixory.app",
      "versionCode": 270,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./docs/assets/og-cover.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/pixory-favicon.png"
    },
    "runtimeVersion": "2.6.8",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/f9528887-4f8b-451d-a851-aa1a45e9abae",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Pixory \u9700\u8981\u8bbf\u95ee\u76f8\u518c\u4ee5\u4fbf\u5bfc\u5165\u56fe\u7247\u548c\u9009\u62e9\u672c\u5730\u5934\u50cf\u3002",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": "Pixory \u9700\u8981\u8bbf\u95ee\u76f8\u518c\u4ee5\u4fbf\u4fdd\u5b58\u539f\u56fe\u3002",
          "savePhotosPermission": "Pixory \u9700\u8981\u5199\u5165\u76f8\u518c\u4ee5\u4fbf\u4fdd\u5b58\u539f\u56fe\u3002",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-video",
      "./plugins/withPixoryAndroidIntents"
    ],
    "extra": {
      "updateCheck": {
        "enabled": true,
        "url": "https://mist01.com/update-version.json",
        "githubLatestUrl": "https://api.github.com/repos/qinghe-zy/Pixory/releases/latest",
        "fallbackDownloadUrl": "https://mist01.com/#download",
        "timeoutMs": 5000
      },
      "announcement": {
        "enabled": true,
        "url": "https://mist01.com/announcement.json",
        "timeoutMs": 5000
      },
      "eas": {
        "projectId": "f9528887-4f8b-451d-a851-aa1a45e9abae"
      }
    },
    "owner": "qinghe.zy"
  }
}